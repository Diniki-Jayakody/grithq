# EmailJS — required for the GritHQ opportunity inquiry form
# Copy this file to .env.local and supply the values from your EmailJS dashboard.
# Do not commit real credentials.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Expected EmailJS template variables:
# name, email, phone, inquiry_type, message, property, submitted_at
